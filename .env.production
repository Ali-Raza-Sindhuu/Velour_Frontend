
# Local development configuration. Never commit a real .env file.
PORT=8000
DB_HOST=localhost
DB_PORT=3306
DB_USER=db_name??
DB_PASSWORD=
DB_NAME=
FRONTEND_URL=
APP_URL=
BACKEND_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret

# Google Cloud OAuth Web application credentials. Keep CLIENT_SECRET private.
CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-google-oauth-client-secret

# cPanel mailbox SMTP (use the exact values shown in cPanel > Email Accounts > Connect Devices)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@yourdomain.com
SMTP_PASS=your-cpanel-mailbox-password
MAIL_FROM="ZeeScents <hello@yourdomain.com>"

# Used only by `npm run test:email`; omit from production.
TEST_EMAIL=you@example.com

# JazzCash Mobile Wallet API (sandbox.jazzcash.com.pk → Integration details).
# Leave blank to hide online JazzCash payment. Set JAZZCASH_ENV=production with live credentials.
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
